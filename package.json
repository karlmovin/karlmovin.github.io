{
  "name": "karl-movins-website",
  "homepage": "http://www.karlmovin.se",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run tailwind && vite",
    "build": "tsc && pnpm run tailwind && vite build",
    "lint": "pnpx @biomejs/biome lint --write",
    "format": "pnpx @biomejs/biome format --write",
    "check": "pnpx @biomejs/biome check --write",
    "preview": "pnpm run build && vite preview",
    "tsc": "tsc",
    "tailwind": "pnpm exec tailwindcss -i ./src/index.css -o ./src/output.css"
  },
  "dependencies": {
    "html-react-parser": "^5.2.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  }
}
